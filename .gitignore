.env*.local
.env.local
.env
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env*.example

# Dependências
node_modules/
.pnpm-store/
.pnp
.pnp.js

# Compilação e Artefatos de Build
.next/
dist/
out/
build/
.turbo/
.swc/
