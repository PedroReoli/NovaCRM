# Ambientes Temporários e Scripts de Execução
scratch/
tmp/
temp/
*.tmp
*.pyc
__pycache__/

# Arquivos de Sistema Operacional (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

